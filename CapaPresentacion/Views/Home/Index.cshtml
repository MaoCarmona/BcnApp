            // Función para formatear JSON con indentación personalizada
            function formatJsonCustom(obj, indent = 0) {
                const indentStr = '    '.repeat(indent); // 4 espacios por nivel
                const nextIndentStr = '    '.repeat(indent + 1);
                
                if (obj === null) return 'null';
                if (typeof obj === 'boolean') return obj.toString();
                if (typeof obj === 'number') {
                    if (!Number.isInteger(obj)) {
                        return Number(obj.toFixed(3)).toString();
                    }
                    return obj.toString();
                }
                if (typeof obj === 'string') return `"${obj}"`;
                
                if (Array.isArray(obj)) {
                    if (obj.length === 0) return '[]';
                    const items = obj.map(item => `${nextIndentStr}${formatJsonCustom(item, indent + 1)}`);
                    return `[\n${items.join(',\n')}\n${indentStr}]`;
                }
                
                if (typeof obj === 'object') {
                    const keys = Object.keys(obj);
                    if (keys.length === 0) return '{}';
                    
                    const items = keys.map(key => {
                        const value = formatJsonCustom(obj[key], indent + 1);
                        return `${nextIndentStr}"${key}": ${value}`;
                    });
                    
                    return `{\n${items.join(',\n')}\n${indentStr}}`;
                }
                
                return obj.toString();
            }

