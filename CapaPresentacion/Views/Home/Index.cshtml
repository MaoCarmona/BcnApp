                const option = document.querySelector('.submodule-link.active')?.getAttribute('data-option') || '';
                const type = document.querySelector('.submodule-link.active')?.getAttribute('data-type') || '';
                const fechaIniRaw = document.getElementById('dateFrom').value;
                const fechaFinRaw = document.getElementById('dateTo').value;

                // Formatear fechas con horas específicas
                const fechaIni = fechaIniRaw ? `${fechaIniRaw} 00:00:00` : '';
                const fechaFin = fechaFinRaw ? `${fechaFinRaw} 23:59:59` : '';

                // Verificar si requiere selección de fecha
                if (requiresDateSelection(type, option)) {
                    // Mostrar modal de selección de fecha
                    showDateSelectionModal(fechaIni, fechaFin, function(useInitialDate) {
                        // Ejecutar la exportación con el parámetro useInitialDate
                        executeExport(fechaIni, fechaFin, useInitialDate);
                    });
                } else {
                    // Ejecutar directamente sin selección de fecha (useInitialDate = false por defecto)
                    executeExport(fechaIni, fechaFin, false);
                }
            }

            // Función para ejecutar la exportación
            async function executeExport(fechaIni, fechaFin, useInitialDate) {
                const option = document.querySelector('.submodule-link.active')?.getAttribute('data-option') || '';
                const type = document.querySelector('.submodule-link.active')?.getAttribute('data-type') || '';

                // Mostrar notificación sticky de progreso
                showExportProgressNotification();

                // Obtener los filtros aplicados actualmente
                const currentSearchTerm = document.getElementById('searchTable')?.value || '';
                const columnFilters = {};
                document.querySelectorAll('.column-filter').forEach(input => {
                    if (input.value && input.value.trim() !== '') {
                        const columnIndex = input.id.replace('col-filter-', '');
                        const columnName = lastGridColumns[parseInt(columnIndex)];
                        if (columnName) {
                            columnFilters[columnName] = input.value.trim();
                        }
                    }
                });

                // Determinar el tipo de consulta y formatear las fechas según corresponda
                let fechaConsulta = '';
                if (requiresDateSelection(type, option)) {
                    // Para consultas que requieren selección de fecha específica
                    if (useInitialDate) {
                        fechaConsulta = `${fechaIni.split(' ')[0]} 00:00:00`;
                    } else {
                        fechaConsulta = `${fechaFin.split(' ')[0]} 23:59:59`;
                    }
                } else {
                    // Para consultas de rango
                    const fechaIniDate = fechaIni.split(' ')[0];
                    const fechaFinDate = fechaFin.split(' ')[0];
                    if (fechaIniDate === fechaFinDate) {
                        fechaConsulta = `${fechaIniDate} 00:00:00 - ${fechaFinDate} 23:59:59`;
                    } else {
                        fechaConsulta = `${fechaIniDate} 00:00:00 - ${fechaFinDate} 23:59:59`;
                    }
                }

                // Obtener el título del módulo seleccionado
                const selectedSubmodule = document.querySelector('.submodule-link.active')?.textContent.trim() || 'Reporte BCN Module';
                
                const formData = new FormData();
                formData.append('option', option);
                formData.append('fechaIni', fechaIni);
                formData.append('fechaFin', fechaFin);
                formData.append('type', type);
                formData.append('useInitialDate', useInitialDate);
                formData.append('fechaConsulta', fechaConsulta);
                formData.append('moduleTitle', selectedSubmodule);
                
                // Agregar viewDataIntegrar = true para opciones de integrar
                if (type === 'integrar') {
                    formData.append('viewDataIntegrar', true);
                }

                // Agregar filtros aplicados
                formData.append('searchTerm', currentSearchTerm);
                formData.append('columnFilters', JSON.stringify(columnFilters));

                try {
                    const response = await fetch('/Integration/ExportToExcel', {
                        method: 'POST',
                        body: formData
                    });

                                    if (response.ok) {
                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    
                    // Generar nombre del archivo con submódulo y fecha
                    const selectedSubmodule = document.querySelector('.submodule-link.active')?.textContent.trim() || 'Submodulo';
                    const dateFrom = document.getElementById('dateFrom').value;
                    const dateTo = document.getElementById('dateTo').value;
                    
                    // Limpiar nombre del submódulo para usar como nombre de archivo
                    const cleanSubmoduleName = selectedSubmodule
                        .replace(/[^a-zA-Z0-9\s]/g, '') // Remover caracteres especiales
                        .replace(/\s+/g, '_') // Reemplazar espacios con guiones bajos
                        .trim();
                    
                    // Formatear fechas
                    const formattedDateFrom = dateFrom ? dateFrom.replace(/-/g, '') : '';
                    const formattedDateTo = dateTo ? dateTo.replace(/-/g, '') : '';
                    
                    // Crear nombre del archivo
                    let fileName = `${cleanSubmoduleName}`;
                    if (formattedDateFrom && formattedDateTo) {
                        if (formattedDateFrom === formattedDateTo) {
                            fileName += `_${formattedDateFrom}`;
                        } else {
                            fileName += `_${formattedDateFrom}_${formattedDateTo}`;
                        }
                    }
                    fileName += '.xlsx';
                    
                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                    
                    // Mostrar notificación de éxito
                    showExportSuccessNotification();
                } else {
                        showExportErrorNotification('Error al exportar a Excel');
                    }
                } catch (error) {
                    showExportErrorNotification('Error de conexión al exportar');
                }
            }
            window.exportGridToExcel = exportGridToExcel;

            // Función para mostrar notificación sticky de progreso de exportación
            function showExportProgressNotification() {
                // Crear el contenedor de notificación si no existe
                let notificationContainer = document.getElementById('stickyNotificationContainer');
                if (!notificationContainer) {
