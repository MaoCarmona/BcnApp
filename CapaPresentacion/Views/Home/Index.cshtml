                             role="progressbar" 
                             style="width: 100%; background-color: var(--ecopetrol-verde);">
                        </div>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        <i class="bi bi-info-circle me-1"></i>
                        Generando archivo Excel con los datos seleccionados...
                    </small>
                `;

                notificationContainer.innerHTML = '';
