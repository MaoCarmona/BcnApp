            // Función para ocultar notificación
            function hideExportNotification() {
                const notificationContainer = document.getElementById('stickyNotificationContainer');
                if (notificationContainer) {
                    notificationContainer.style.animation = 'slideOutRight 0.5s ease-out';
                    setTimeout(() => {
                        notificationContainer.remove();
                    }, 500);
                }
            }

            // Exponer función globalmente
            window.hideExportNotification = hideExportNotification;

            // Sidebar colapsable
            const sidebar = document.getElementById('sidebarMenu');
            const mainContent = document.getElementById('mainContent');
            const toggleBtn = document.getElementById('toggleSidebar');
            const sidebarBackdrop = document.getElementById('sidebarBackdrop');

            function toggleSidebar() {
                sidebar.classList.toggle('collapsed');
                
                // Cambiar el ícono del botón
                const icon = toggleBtn.querySelector('i');
                if (sidebar.classList.contains('collapsed')) {
                    icon.className = 'bi bi-list';
                    toggleBtn.title = 'Expandir menú';
                    toggleBtn.setAttribute('data-bs-original-title', 'Expandir menú');
                } else {
                    icon.className = 'bi bi-list';
                    toggleBtn.title = 'Colapsar menú';
                    toggleBtn.setAttribute('data-bs-original-title', 'Colapsar menú');
                }
                
                // Actualizar tooltip si existe
                const tooltip = bootstrap.Tooltip.getInstance(toggleBtn);
                if (tooltip) {
                    tooltip.dispose();
                    new bootstrap.Tooltip(toggleBtn);
                }
                
                // Guardar el estado en localStorage
                localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
            }
            
            if (toggleBtn) {
                toggleBtn.addEventListener('click', toggleSidebar);
            }
            
            // Restaurar el estado del sidebar al cargar la página
            const sidebarCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            if (sidebarCollapsed) {
                sidebar.classList.add('collapsed');
                const icon = toggleBtn.querySelector('i');
                icon.className = 'bi bi-list';
                toggleBtn.title = 'Expandir menú';
            }
            
            // Por defecto, expandido en desktop y colapsado en móvil
            if (window.innerWidth < 768) {
                if (!sidebarCollapsed) {
                    sidebar.classList.add('collapsed');
                    const icon = toggleBtn.querySelector('i');
                    icon.className = 'bi bi-list';
                    toggleBtn.title = 'Expandir menú';
                }
            }
            
            window.addEventListener('resize', function () {
                if (window.innerWidth >= 768) {
                    // En desktop, mantener el estado guardado
                    const savedState = localStorage.getItem('sidebarCollapsed') === 'true';
                    sidebar.classList.toggle('collapsed', savedState);
                    
                    const icon = toggleBtn.querySelector('i');
                    if (savedState) {
                        icon.className = 'bi bi-list';
                        toggleBtn.title = 'Expandir menú';
                    } else {
                        icon.className = 'bi bi-x-lg';
                        toggleBtn.title = 'Colapsar menú';
                    }
                } else {
                    // En móvil, siempre colapsado
                    sidebar.classList.add('collapsed');
                    const icon = toggleBtn.querySelector('i');
                    icon.className = 'bi bi-list';
                    toggleBtn.title = 'Expandir menú';
                }
            });

            // Variables para búsqueda y paginación
            let originalGridData = [];
            let filteredGridData = [];
            let currentSearchTerm = '';
            let columnFilters = {};
            let currentPage = 1;
            let pageSize = 10;
            let volumeSeparatorColumn = null;

            // Nueva función para aplicar filtros por columna (solo filtra datos, no renderiza)
            function applyColumnFilters() {
                if (!originalGridData) {
                    filteredGridData = [];
                    return;
                }
                
                let filtered = [...originalGridData];

                // Aplicar filtro global primero
                if (currentSearchTerm && currentSearchTerm.trim() !== '') {
                    const globalTerm = currentSearchTerm.toLowerCase().trim();
                    filtered = filtered.filter(row => {
                        return lastGridColumns.some(column => {
                            const cellValue = row[column];
                            if (cellValue === null || cellValue === undefined) return false;
                            return cellValue.toString().toLowerCase().includes(globalTerm);
                        });
                    });
                }

                // Aplicar filtros por columna
                Object.keys(columnFilters).forEach(column => {
                    const filterValue = columnFilters[column];
                    if (filterValue && filterValue.trim() !== '') {
                        const columnTerm = filterValue.toLowerCase().trim();
                        filtered = filtered.filter(row => {
                            const cellValue = row[column];
                            if (cellValue === null || cellValue === undefined) return false;
                            return cellValue.toString().toLowerCase().includes(columnTerm);
                        });
                    }
                });

                filteredGridData = filtered;
            }


            // Nueva función para mostrar información de filtros aplicados
            function updateFiltersInfo() {
                const activeFilters = [];
                
                if (currentSearchTerm && currentSearchTerm.trim() !== '') {
                    activeFilters.push(`Global: "${currentSearchTerm}"`);
                }
                
                Object.keys(columnFilters).forEach(column => {
                    const filterValue = columnFilters[column];
                    if (filterValue && filterValue.trim() !== '') {
                        activeFilters.push(`${column}: "${filterValue}"`);
                    }
                });

                return activeFilters;
            }

            // Nueva función para limpiar todos los filtros
            function clearAllFilters(shouldRender = true) {
                currentSearchTerm = '';
                columnFilters = {};
                const searchInput = document.getElementById('searchTable');
                if (searchInput) {
                    searchInput.value = '';
                }
                
                // Limpiar todos los filtros de columna
                document.querySelectorAll('.column-filter').forEach(input => {
                    input.value = '';
                });

                if (shouldRender) {
                    currentPage = 1;
                    renderGrid(lastGridColumns, undefined, lastGridTitle);
                }
            }

            // Función de búsqueda/filtrado (actualizada)
            function filterTableData(searchTerm) {
                currentSearchTerm = searchTerm;
                currentPage = 1; // Resetear a la primera página con cada búsqueda
                renderGrid(lastGridColumns, undefined, lastGridTitle);
            }

            // Función para actualizar el placeholder del buscador
            function updateSearchPlaceholder() {
                if (searchInput && originalGridData.length > 0) {
                    const totalRecords = originalGridData.length;
                    const totalColumns = lastGridColumns.length;
                    searchInput.placeholder = `Buscar en ${totalRecords} registros`;
                } else if (searchInput) {
                    searchInput.placeholder = 'Buscar en tabla...';
                }
            }

            // Event listeners para el buscador
            const searchInput = document.getElementById('searchTable');
            const clearSearchBtn = document.getElementById('clearSearch');

            if (searchInput) {
                // Búsqueda en tiempo real con debounce para no sobrecargar
                let debounceTimer;
                searchInput.addEventListener('input', function () {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        filterTableData(this.value);
                    }, 300);
                });

                // Búsqueda al presionar Enter
                searchInput.addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') {
                        filterTableData(this.value);
                    }
                });
            }

            if (clearSearchBtn) {
                clearSearchBtn.addEventListener('click', function () {
                    clearAllFilters(true);
                    searchInput.focus();
                });
            }

            // Función para limpiar completamente cuando no hay submódulo seleccionado
            function clearAllData() {
                if (!selectedOption || !selectedType) {
                    clearDataSection();
                }
            }

            // Limpiar datos al cargar la página si no hay submódulo seleccionado
            document.addEventListener('DOMContentLoaded', function() {
                if (!selectedOption || !selectedType) {
                    clearDataSection();
                }
            });

            // Modificar la función renderGrid para trabajar con datos filtrados y paginación
            function renderGridOriginal(columns, data, title) {
                console.log('renderGrid called with:', { columns, dataLength: data?.length, title });

                const isNewQuery = data !== undefined;
                const header = document.getElementById('mainGridHeader');
                const body = document.getElementById('mainGridBody');

                if (!header || !body) {
                    console.error('Header or body elements not found');
                    return;
                }

                // Si es una nueva consulta, se actualizan los datos originales y se redibuja el encabezado.
                if (isNewQuery) {
                    originalGridData = (data || []).map(row => {
                        const newRow = {};
                        (columns || []).forEach(col => {
                            newRow[col] = (row && col in row && row[col] !== null && row[col] !== undefined) ? row[col] : '';
                        });
                        return newRow;
                    });
                    lastGridColumns = columns || [];
                    lastGridTitle = title || 'SELECCIONA UN MÓDULO PARA VISUALIZAR DATOS';
                    
                    updateSearchPlaceholder();
                    updateFiltersInfo();

                    // --- DIBUJAR ENCABEZADO (SOLO EN NUEVAS CONSULTAS) ---
                    header.innerHTML = '';
                    
                    separatorColumns = new Set(); // Reset on new query

                    // Header con título
                    const headerRow1 = document.createElement('tr');
                    const thTitle = document.createElement('th');
                    thTitle.colSpan = selectedType === 'ares' ? lastGridColumns.length + 1 : lastGridColumns.length;
                    thTitle.className = 'main-title';
                    thTitle.id = 'mainGridTitle';
                    
                    let titleContent = `<div>${lastGridTitle}</div>`;
                    
                    // Agregar información de consulta de inventario si es una consulta de inventario
                    if (requiresDateSelection(selectedType, selectedOption)) {
                        const selectedDate = lastQueryDateInfo.includes('Fecha de Consulta:') ? 
                            lastQueryDateInfo.replace('Fecha de Consulta: ', '') : 
                            (lastQueryDateInfo.includes('Rango:') ? 
                                lastQueryDateInfo.replace('Rango: ', '').split(' al ')[1] : 
                                '');
                        
                        if (selectedDate) {
                            // La fecha ya está en formato AAAA-MM-DD HH:MM:SS
                            titleContent += `<div style="font-size: 0.75rem; font-weight: normal; margin-top: 5px;">Consulta de Inventario: ${selectedDate}</div>`;
                        }
                    } else if (lastQueryDateInfo) {
                        titleContent += `<div style="font-size: 0.75rem; font-weight: normal; margin-top: 5px;">${lastQueryDateInfo}</div>`;
                    }
                    thTitle.innerHTML = titleContent;

                    headerRow1.appendChild(thTitle);
                    header.appendChild(headerRow1);

                    // Header con nombres de columnas
                    const headerRow2 = document.createElement('tr');
                    const headerRow3 = document.createElement('tr');
                    const groupPrefixes = ['Volumen', 'Masa', 'Muestra', 'Pedido', 'Vol', 'Mas', 'Origen', 'Destino', 'Auditoria'];
                    const needsComplexHeader = lastGridColumns.some(c => groupPrefixes.some(p => c.includes(p)));

                    // ARES Checkbox logic first
                    if (selectedType === 'ares') {
                        const thCheckbox = document.createElement('th');
                        if (needsComplexHeader) {
                            thCheckbox.rowSpan = 2;
                        }
                        thCheckbox.innerHTML = '<input type="checkbox" id="selectAllCheckbox" class="form-check-input">';
                        thCheckbox.style.width = '40px';
                        thCheckbox.style.textAlign = 'center';
                        thCheckbox.style.verticalAlign = 'middle';
                        headerRow2.appendChild(thCheckbox);
                    }

                    if (needsComplexHeader) {
                        const headerStructure = [];
                        const processedCols = new Set();

                        lastGridColumns.forEach(col => {
                            if (processedCols.has(col)) return;

                            let groupFound = false;

                            for (const prefix of groupPrefixes) {
                                // Buscar columnas que contengan el prefijo (sin espacios)
                                if (col.includes(prefix) || col === `UM${prefix}` || col === `UM ${prefix}` || col === `UM${prefix.toUpperCase()}`) {
                                    const groupCols = lastGridColumns.filter(c => 
                                        c.includes(prefix) || c === `UM${prefix}` || c === `UM ${prefix}` || c === `UM${prefix.toUpperCase()}`
                                    );
                                    headerStructure.push({ name: prefix, isGroup: true, cols: groupCols });
                                    if (groupCols.length > 0) {
                                        separatorColumns.add(groupCols[groupCols.length - 1]);
                                    }
                                    groupCols.forEach(c => processedCols.add(c));
                                    groupFound = true;
                                    break;
                                }
                            }

                            if (!groupFound) {
                                headerStructure.push({ name: col, isGroup: false });
                                processedCols.add(col);
                            }
                        });

                        const styleHeaderCell = (th) => {
                            th.style.padding = '0.3rem';
                            th.style.fontSize = '0.8rem';
                        };

                        headerStructure.forEach(item => {
                            if (item.isGroup) {
                                const thGroup = document.createElement('th');
                                thGroup.textContent = item.name;
                                thGroup.colSpan = item.cols.length;
                                thGroup.style.textAlign = 'center';
                                styleHeaderCell(thGroup);
                                headerRow2.appendChild(thGroup);

                                item.cols.forEach(colName => {
                                    const thSub = document.createElement('th');
                                    let subHeaderText = colName;
                                    
                                    // Extraer el texto del subencabezado
                                    if (colName.includes(item.name)) {
                                        subHeaderText = colName.replace(item.name, '').trim();
                                        if (subHeaderText === '') {
                                            subHeaderText = item.name;
                                        }
                                    } else if (colName.startsWith('UM') || colName.includes('UM')) {
                                        subHeaderText = 'UM';
                                    }
                                    
                                    thSub.textContent = subHeaderText;
                                    if (separatorColumns.has(colName)) {
                                        thSub.style.borderRight = '2px solid #dee2e6';
                                    }
                                    styleHeaderCell(thSub);
                                    headerRow3.appendChild(thSub);
                                });
                            } else { // Standalone column
                                const th = document.createElement('th');
                                th.textContent = item.name;
                                th.rowSpan = 2;
                                th.style.verticalAlign = 'middle';
                                styleHeaderCell(th);
                                headerRow2.appendChild(th);
                            }
                        });

                        header.appendChild(headerRow2);
                        header.appendChild(headerRow3);
                    } else {
                        lastGridColumns.forEach(col => {
                            const th = document.createElement('th');
                            th.textContent = col;
                            headerRow2.appendChild(th);
                        });
                        header.appendChild(headerRow2);
                    }

                    // Fila de filtros por columna
                    const filterRow = document.createElement('tr');
                    filterRow.className = 'column-filters-row';
                    
                    if (selectedType === 'ares') {
                        const tdCheckboxFilter = document.createElement('td');
                        tdCheckboxFilter.style.padding = '4px';
                        filterRow.appendChild(tdCheckboxFilter);
                    }
                    
                    lastGridColumns.forEach((col, index) => {
                        const td = document.createElement('td');
                        td.style.padding = '4px';
                        
                        const filterInput = document.createElement('input');
                        filterInput.id = `col-filter-${index}`;
                        filterInput.type = 'text';
                        filterInput.className = 'form-control form-control-sm column-filter';
                        filterInput.placeholder = `Filtrar ${col}...`;
                        filterInput.style.fontSize = '11px';
                        filterInput.value = columnFilters[col] || '';
                        
                        filterInput.addEventListener('input', function() {
                            const filterValue = this.value;
                            if (filterValue.trim() === '') {
                                delete columnFilters[col];
                            } else {
                                columnFilters[col] = filterValue;
                            }
                            currentPage = 1;
                            renderGrid(lastGridColumns, undefined, lastGridTitle);
                        });

                        filterInput.addEventListener('keypress', function(e) {
                            if (e.key === 'Enter') {
                                const filterValue = this.value;
                                if (filterValue.trim() === '') {
                                    delete columnFilters[col];
                                } else {
                                    columnFilters[col] = filterValue;
                                }
                                currentPage = 1;
                                renderGrid(lastGridColumns, undefined, lastGridTitle);
                            }
                        });

                        if (col === volumeSeparatorColumn) {
                            td.style.borderRight = '2px solid #dee2e6';
                        }
                        td.appendChild(filterInput);
                        filterRow.appendChild(td);
                    });
                    header.appendChild(filterRow);
                }

                // Siempre se aplica el filtro y se redibuja el cuerpo de la tabla.
                applyColumnFilters();
                body.innerHTML = '';
                
                lastGridData = filteredGridData;

                let dataToRender = filteredGridData;

                if (pageSize > 0) {
                    const start = (currentPage - 1) * pageSize;
                    const end = start + pageSize;
                    dataToRender = dataToRender.slice(start, end);
                }
                
                if (!dataToRender || dataToRender.length === 0) {
                    const activeFilters = updateFiltersInfo();
                    if (activeFilters.length > 0) {
                        // Si hay filtros aplicados, mostrar mensaje de búsqueda sin resultados
                        const colspan = selectedType === 'ares' ? (lastGridColumns.length || 0) + 1 : (lastGridColumns.length || 1);
                        body.innerHTML = `<tr><td colspan="${colspan}" class="text-center py-4">
                            <div class="no-data-message warning">
                                <i class="bi bi-search"></i>
                                <h5>No se encontraron resultados</h5>
                                <p>No se encontraron resultados con los filtros aplicados</p>
                                <small>
                                    <i class="bi bi-info-circle me-1"></i>
                                    Intente ajustar los criterios de búsqueda o limpiar los filtros para ver más resultados.
                                </small>
                            </div>
                        </td></tr>`;
                    } else {
                        // Si no hay filtros, usar el mensaje elegante
                        renderNoDataMessage('No hay datos para mostrar');
                        return; // Salir de la función ya que renderNoDataMessage maneja todo
                    }
                } else {
                    for (let i = 0; i < dataToRender.length; i++) {
                        const row = dataToRender[i];
                        const tr = document.createElement('tr');
                        
                        if (selectedType === 'ares') {
                            const tdCheckbox = document.createElement('td');
                            tdCheckbox.style.textAlign = 'center';
                            const checkbox = document.createElement('input');
                            checkbox.type = 'checkbox';
                            checkbox.className = 'form-check-input ares-checkbox';
                            // Usar el índice real en filteredGridData, no en la página actual
                            const realIndex = filteredGridData.findIndex(row => 
                                JSON.stringify(row) === JSON.stringify(dataToRender[i])
                            );
                            checkbox.value = realIndex >= 0 ? realIndex : i;
                            
                            // Sincronizar el estado del checkbox con la selección global
                            if (selectedAresData.has(checkbox.value)) {
                                checkbox.checked = true;
                            }
                            
                            checkbox.addEventListener('change', function() {
                                if (this.checked) {
                                    selectedAresData.add(this.value);
                                } else {
                                    selectedAresData.delete(this.value);
                                }
                                updateAresSelectionCount();
                            });
                            tdCheckbox.appendChild(checkbox);
                            tr.appendChild(tdCheckbox);
                        }
                        
                        lastGridColumns.forEach(col => {
                            const td = document.createElement('td');
                            let value = row[col];
                            if (value === undefined || value === null) value = '';
                            
                            // Manejo especial para la columna Json Movimientos
                            if (col === 'Json Movimientos' && value) {
                                const button = document.createElement('button');
                                button.className = 'btn btn-sm btn-outline-primary';
                                button.textContent = 'Ver JSON';
                                button.onclick = function() {
                                    showJsonModal(value);
                                };
                                td.appendChild(button);
                            } else {
                                // Formatear números decimales con máximo 3 decimales
                                if (typeof value === 'number' && !Number.isInteger(value)) {
                                    value = Number(value.toFixed(3));
                                }
                                td.textContent = value;
                            }
                            
                            if (col === volumeSeparatorColumn) {
                                td.style.borderRight = '2px solid #dee2e6';
                            }
                            tr.appendChild(td);
                        });
                        body.appendChild(tr);
                    }
                }
                
                if (selectedType === 'ares') {
                    const selectAllCheckbox = document.getElementById('selectAllCheckbox');
                    if (selectAllCheckbox) {
                        selectAllCheckbox.addEventListener('change', function() {
                            if (this.checked) {
                                // Seleccionar TODOS los registros filtrados, no solo los de la página actual
                                selectedAresData.clear();
                                for (let i = 0; i < filteredGridData.length; i++) {
                                    selectedAresData.add(i.toString());
                                }
                                // Marcar todos los checkboxes visibles
                                const checkboxes = document.querySelectorAll('.ares-checkbox');
                                checkboxes.forEach(checkbox => {
                                    checkbox.checked = true;
                                });
                            } else {
                                // Deseleccionar todos
                                selectedAresData.clear();
                                const checkboxes = document.querySelectorAll('.ares-checkbox');
                                checkboxes.forEach(checkbox => {
                                    checkbox.checked = false;
                                });
                            }
                            updateAresSelectionCount();
                        });
                    }
                }
                
                // Actualizar el estado del checkbox principal después de renderizar
                if (selectedType === 'ares') {
                    updateSelectAllCheckboxState();
                    // Sincronizar los checkboxes visibles con el estado global
                    setTimeout(() => syncVisibleCheckboxes(), 100);
                }

                // Solo renderizar paginación si hay datos válidos y no estamos en estado de limpieza
                if (filteredGridData && filteredGridData.length > 0 && lastGridColumns && lastGridColumns.length > 0) {
                    renderPagination(filteredGridData.length);
                } else {
                    // Ocultar paginación si no hay datos
                    const paginationContainer = document.getElementById('paginationContainer');
                    if (paginationContainer) {
                        paginationContainer.style.display = 'none';
                    }
                }
            }

            // Función para mostrar mensaje elegante cuando no hay datos
            function renderNoDataMessage(message) {
                const header = document.getElementById('mainGridHeader');
                const body = document.getElementById('mainGridBody');

                if (!header || !body) {
                    console.error('Header or body elements not found');
                    return;
                }

                // Limpiar contenido anterior
                header.innerHTML = '';
                body.innerHTML = '';

                // Crear encabezado con título
                const headerRow = document.createElement('tr');
                const thTitle = document.createElement('th');
                thTitle.colSpan = 1;
                thTitle.className = 'main-title';
                thTitle.id = 'mainGridTitle';
                thTitle.textContent = document.querySelector('.submodule-link.active')?.textContent.trim() || 'NOMBRE DE INTERFASE DE VISUALIZACIÓN';
                headerRow.appendChild(thTitle);
                header.appendChild(headerRow);

                // Crear mensaje elegante
                const messageRow = document.createElement('tr');
                const messageCell = document.createElement('td');
                messageCell.className = 'text-center py-5';
                
                // Determinar el tipo de mensaje y el ícono correspondiente
                let iconClass = 'bi-inbox';
                let messageType = '';
                let titleText = 'No hay datos para mostrar';
                
                if (message.toLowerCase().includes('exitoso') || message.toLowerCase().includes('procesado')) {
                    iconClass = 'bi-check-circle';
                    messageType = 'success';
                    titleText = 'Operación completada';
                } else if (message.toLowerCase().includes('error')) {
                    iconClass = 'bi-exclamation-triangle';
                    messageType = 'warning';
                    titleText = 'Información importante';
                } else {
                    messageType = 'info';
                }

                messageCell.innerHTML = `
                    <div class="no-data-message ${messageType}">
                        <i class="bi ${iconClass}"></i>
                        <h5>${titleText}</h5>
                        <p>${message}</p>
                        <small>
                            <i class="bi bi-info-circle me-1"></i>
                            La consulta se ejecutó correctamente.
                        </small>
                    </div>
                `;
                
                messageRow.appendChild(messageCell);
                body.appendChild(messageRow);

                // Ocultar controles de paginación
                const paginationContainer = document.getElementById('paginationContainer');
                if (paginationContainer) {
                    paginationContainer.style.display = 'none';
                }
            }

            // Reemplazar la función renderGrid original
            renderGrid = renderGridOriginal;

            // Nueva función para renderizar la paginación
            function renderPagination(totalItems) {
                const paginationContainer = document.getElementById('paginationContainer');
                const paginationInfo = document.getElementById('paginationInfo');
                const paginationControls = document.getElementById('paginationControls');

                if (!paginationContainer || !paginationInfo || !paginationControls) return;

                if (totalItems === 0) {
                    paginationContainer.style.display = 'none';
                    return;
                }
                paginationContainer.style.display = 'flex';

                paginationControls.innerHTML = ''; // Limpiar controles existentes

                // Caso especial para "Mostrar Todos"
                if (pageSize <= 0) {
                    paginationInfo.textContent = `Mostrando ${totalItems} registro${totalItems !== 1 ? 's' : ''}`;

                    const ul = document.createElement('ul');
                    ul.className = 'pagination pagination-sm mb-0';
                    
                    const labelLi = document.createElement('li');
                    labelLi.className = 'page-item disabled';
                    labelLi.innerHTML = `<span class="page-link">Página</span>`;
                    ul.appendChild(labelLi);

                    const pageLi = document.createElement('li');
                    pageLi.className = 'page-item active';
                    pageLi.innerHTML = `<a class="page-link" href="#">1</a>`;
                    ul.appendChild(pageLi);
                    paginationControls.appendChild(ul);
                    
                    return; // Fin de la función para este caso
                }

                const totalPages = Math.ceil(totalItems / pageSize);
                const startItem = (currentPage - 1) * pageSize + 1;
                const endItem = Math.min(startItem + pageSize - 1, totalItems);

                paginationInfo.textContent = `Mostrando ${startItem} a ${endItem} de ${totalItems} registros`;
                
                const ul = document.createElement('ul');
                ul.className = 'pagination pagination-sm mb-0'; // mb-0 para alinear

                const labelLi = document.createElement('li');
                labelLi.className = 'page-item disabled';
                labelLi.innerHTML = `<span class="page-link">Página</span>`;
                ul.appendChild(labelLi);

                // Anterior
                const prevLi = document.createElement('li');
                prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
                prevLi.innerHTML = `<a class="page-link" href="#" data-page="${currentPage - 1}">&laquo;</a>`;
                ul.appendChild(prevLi);

                // Lógica de paginación tipo GitHub
                const pages = [];
                const maxPages = 5;
                const half = Math.floor(maxPages / 2);
                let start = currentPage - half;
                let end = currentPage + half;

                if (start < 1) {
                    start = 1;
                    end = Math.min(maxPages, totalPages);
                }
                if (end > totalPages) {
                    end = totalPages;
                    start = Math.max(1, totalPages - maxPages + 1);
                }

                if (start > 1) {
                    pages.push({ page: 1, text: '1' });
                    if (start > 2) pages.push({ text: '...' });
                }

                for (let i = start; i <= end; i++) {
                    pages.push({ page: i, text: i.toString() });
                }

                if (end < totalPages) {
                    if (end < totalPages - 1) pages.push({ text: '...' });
                    pages.push({ page: totalPages, text: totalPages.toString() });
                }

                pages.forEach(p => {
                    const pageLi = document.createElement('li');
                    if (p.page) {
                        pageLi.className = `page-item ${currentPage === p.page ? 'active' : ''}`;
                        pageLi.innerHTML = `<a class="page-link" href="#" data-page="${p.page}">${p.text}</a>`;
                    } else {
                        pageLi.className = 'page-item disabled';
                        pageLi.innerHTML = `<span class="page-link">${p.text}</span>`;
                    }
                    ul.appendChild(pageLi);
                });

                // Siguiente
                const nextLi = document.createElement('li');
                nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
                nextLi.innerHTML = `<a class="page-link" href="#" data-page="${currentPage + 1}">&raquo;</a>`;
                ul.appendChild(nextLi);

                paginationControls.appendChild(ul);
            }

            // Event listener para controles de paginación
            document.getElementById('paginationControls').addEventListener('click', function (e) {
                e.preventDefault();
                const target = e.target;
                if (target.tagName === 'A' && target.hasAttribute('data-page')) {
                    const page = parseInt(target.getAttribute('data-page'));
                    if (page > 0 && page <= Math.ceil(filteredGridData.length / pageSize)) {
                        currentPage = page;
                        renderGrid(lastGridColumns, undefined, lastGridTitle);
                        
                        // Sincronizar checkboxes después de cambiar de página
                        if (selectedType === 'ares') {
                            setTimeout(() => syncVisibleCheckboxes(), 200);
                        }
                    }
                }
            });

            // Event listener para el selector de tamaño de página
            document.getElementById('pageSizeSelect').addEventListener('change', function () {
                pageSize = parseInt(this.value);
                currentPage = 1;
                renderGrid(lastGridColumns, undefined, lastGridTitle);
                
                // Sincronizar checkboxes después de cambiar el tamaño de página
                if (selectedType === 'ares') {
                    setTimeout(() => syncVisibleCheckboxes(), 200);
                }
            });
        });
    </script>
} 