<!-- Modal para selección de fecha -->
<div class="modal fade" id="dateSelectionModal" tabindex="-1" aria-labelledby="dateSelectionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dateSelectionModalLabel">Selección de Fecha</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Qué fecha desea utilizar para la consulta?</p>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="dateSelection" id="initialDate" value="true">
                    <label class="form-check-label" for="initialDate">
                        <strong>Inventario Inicial:</strong> <span id="initialDateValue"></span>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="dateSelection" id="finalDate" value="false" checked>
                    <label class="form-check-label" for="finalDate">
                        <strong>Inventario Final:</strong> <span id="finalDateValue"></span>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="confirmDateSelection">Confirmar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para mostrar JSON -->
<div class="modal fade" id="jsonModal" tabindex="-1" aria-labelledby="jsonModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="jsonModalLabel">JSON de Movimiento Logístico</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Cadena de Texto del JSON de Movimiento Logístico</p>
                <pre id="jsonContent" style="max-height: 500px; overflow-y: auto; background-color: #f8f9fa; padding: 20px; border-radius: 8px; border: 1px solid #dee2e6; font-family: 'Consolas', 'Monaco', 'Courier New', monospace; font-size: 14px; line-height: 1.6; white-space: pre-wrap; word-wrap: break-word;"></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                @* <button type="button" class="btn btn-primary" id="copyJsonBtn">Copiar JSON</button> *@
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Definir rutas absolutas usando Razor para que funcionen en cualquier contexto
        const ecopetrolLogo = '@Url.Content("~/assets/ecopetrol.png")';
        const aresLogo = '@Url.Content("~/assets/ares.png")';
        
        $(document).ready(function () {
            
            // Variables para manejo de fechas
            let dateFromInput = document.getElementById('dateFrom');
            let dateToInput = document.getElementById('dateTo');

            // Función para validar y ajustar fechas
            function validateAndAdjustDates() {
                let fromDate = new Date(dateFromInput.value);
                let toDate = new Date(dateToInput.value);
                
                // Validar que las fechas sean válidas
                if (isNaN(fromDate.getTime()) || isNaN(toDate.getTime())) {
                    return;
                }
                
                // Si la fecha de fin es menor a la fecha de inicio, ajustar
                if (toDate < fromDate) {
                    toDate = new Date(fromDate);
                    dateToInput.value = toDate.toISOString().slice(0, 10);
                    
                    // Mostrar notificación visual temporal
                    showDateValidationMessage('La fecha de fin se ha ajustado automáticamente a la fecha de inicio');
                }
                
                // Actualizar el atributo min de la fecha de fin
                dateToInput.min = dateFromInput.value;
                
                // Actualizar el atributo max de la fecha de inicio (no puede ser mayor a la fecha de fin)
                dateFromInput.max = dateToInput.value;
            }

            // Función para mostrar mensaje de validación temporal
            function showDateValidationMessage(message) {
                // Crear o actualizar el mensaje de validación
                let validationMessage = document.getElementById('dateValidationMessage');
                if (!validationMessage) {
                    validationMessage = document.createElement('div');
                    validationMessage.id = 'dateValidationMessage';
                    validationMessage.className = 'alert alert-info alert-sm mt-2';
                    validationMessage.style.fontSize = '0.75rem';
                    validationMessage.style.padding = '0.5rem';
                    
                    // Insertar después de los inputs de fecha
                    const dateInputsContainer = dateFromInput.closest('.row');
                    dateInputsContainer.parentNode.insertBefore(validationMessage, dateInputsContainer.nextSibling);
                }
                
                validationMessage.innerHTML = `<i class="bi bi-info-circle me-1"></i>${message}`;
                validationMessage.style.display = 'block';
                
                // Ocultar después de 3 segundos
                setTimeout(() => {
                    validationMessage.style.display = 'none';
                }, 3000);
            }

            // Event listeners para validación de fechas
            dateFromInput.addEventListener('change', function() {
                // Actualizar automáticamente la fecha de fin para que sea igual a la fecha de inicio
                dateToInput.value = this.value;
                validateAndAdjustDates();
            });

            dateToInput.addEventListener('change', function() {
                validateAndAdjustDates();
            });

            // Inicializar validación al cargar la página
            validateAndAdjustDates();
            
            // Validación adicional para fechas futuras
            function validateFutureDates() {
                const today = new Date();
                today.setHours(0, 0, 0, 0); // Resetear a inicio del día
                
                const fromDate = new Date(dateFromInput.value);
                const toDate = new Date(dateToInput.value);
                
                if (fromDate > today) {
                    dateFromInput.value = today.toISOString().slice(0, 10);
                    showDateValidationMessage('La fecha de inicio no puede ser futura. Se ha ajustado a hoy.');
                }
                
                if (toDate > today) {
                    dateToInput.value = today.toISOString().slice(0, 10);
                    showDateValidationMessage('La fecha de fin no puede ser futura. Se ha ajustado a hoy.');
                }
                
                validateAndAdjustDates();
            }
            
            // Aplicar validación de fechas futuras también
            dateFromInput.addEventListener('change', validateFutureDates);
            dateToInput.addEventListener('change', validateFutureDates);
            
            // Función para actualizar estado de botones de navegación
            function updateNavigationButtons() {
                const btnPrev = document.getElementById('btnPrev');
                const btnNext = document.getElementById('btnNext');
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                
                const fromDate = new Date(dateFromInput.value);
                const toDate = new Date(dateToInput.value);
                
                // El botón "Día anterior" siempre está habilitado
                // Solo se deshabilita si ambas fechas son el día más antiguo posible (ej: 1900-01-01)
                const minDate = new Date('1900-01-01');
                if (fromDate <= minDate && toDate <= minDate) {
                    btnPrev.disabled = true;
                    btnPrev.classList.add('disabled');
                } else {
                    btnPrev.disabled = false;
                    btnPrev.classList.remove('disabled');
                }
                
                // Deshabilitar botón "Día siguiente" solo si la fecha de fin es hoy o posterior
                // porque no se puede ir al futuro
                if (toDate >= today) {
                    btnNext.disabled = true;
                    btnNext.classList.add('disabled');
                } else {
                    btnNext.disabled = false;
                    btnNext.classList.remove('disabled');
                }
            }
            
            // Aplicar actualización de botones en las validaciones
            const originalValidateFutureDates = validateFutureDates;
            validateFutureDates = function() {
                originalValidateFutureDates();
                updateNavigationButtons();
            };
            
            // Inicializar estado de botones
            updateNavigationButtons();

            // Botones de fechas rápidas
            document.getElementById('btnPrev').onclick = function () {
                let fromDate = new Date(dateFromInput.value);
                let toDate = new Date(dateToInput.value);
                fromDate.setDate(fromDate.getDate() - 1); // Solo 1 día atrás
                toDate.setDate(toDate.getDate() - 1);     // Solo 1 día atrás
                dateFromInput.value = fromDate.toISOString().slice(0, 10);
                dateToInput.value = toDate.toISOString().slice(0, 10);
                validateFutureDates(); // Usar la función completa que incluye validación de fechas futuras
            };
            document.getElementById('btnNext').onclick = function () {
                let fromDate = new Date(dateFromInput.value);
                let toDate = new Date(dateToInput.value);
                fromDate.setDate(fromDate.getDate() + 1); // Solo 1 día adelante
                toDate.setDate(toDate.getDate() + 1);     // Solo 1 día adelante
                dateFromInput.value = fromDate.toISOString().slice(0, 10);
                dateToInput.value = toDate.toISOString().slice(0, 10);
                validateFutureDates(); // Usar la función completa que incluye validación de fechas futuras
            };

            let lastGridData = [];
            let lastGridColumns = [];
            let lastGridTitle = '';

            function renderGrid(columns, data, title) {
                console.log('renderGrid called with:', { columns, dataLength: data?.length, title });

                lastGridData = data || [];
                lastGridColumns = columns || [];
                lastGridTitle = title || 'NOMBRE DE INTERFASE DE VISUALIZACIÓN';
                
                const header = document.getElementById('mainGridHeader');
                const body = document.getElementById('mainGridBody');

                if (!header || !body) {
                    console.error('Header or body elements not found');
                    return;
                }

                header.innerHTML = '';
                body.innerHTML = '';

                // Header
                const headerRow1 = document.createElement('tr');
                const thTitle = document.createElement('th');
                thTitle.colSpan = selectedType === 'ares' ? columns.length + 1 : columns.length;
                thTitle.className = 'main-title';
                thTitle.id = 'mainGridTitle';
                thTitle.textContent = lastGridTitle;
                headerRow1.appendChild(thTitle);
                header.appendChild(headerRow1);

                const headerRow2 = document.createElement('tr');
                
                // Agregar columna de checkbox para ARES
                if (selectedType === 'ares') {
                    const thCheckbox = document.createElement('th');
                    thCheckbox.innerHTML = '<input type="checkbox" id="selectAllCheckbox" class="form-check-input">';
                    thCheckbox.style.width = '40px';
                    thCheckbox.style.textAlign = 'center';
                    headerRow2.appendChild(thCheckbox);
                }
                
                columns.forEach(col => {
                    const th = document.createElement('th');
                    th.textContent = col;
                    headerRow2.appendChild(th);
                });
                header.appendChild(headerRow2);

                // Data
                if (!data || data.length === 0) {
                    console.log('No data to render');
                    const colspan = selectedType === 'ares' ? columns.length + 1 : columns.length;
                    body.innerHTML = '<tr><td colspan="' + colspan + '" class="text-center text-muted"><i class="bi bi-inbox"></i> No hay datos para mostrar</td></tr>';
                    return;
                }

                for (let i = 0; i < data.length; i++) {
                    const row = data[i];
                    const tr = document.createElement('tr');
                    
                    // Agregar checkbox para ARES
                    if (selectedType === 'ares') {
                        const tdCheckbox = document.createElement('td');
                        tdCheckbox.style.textAlign = 'center';
                        const checkbox = document.createElement('input');
                        checkbox.type = 'checkbox';
                        checkbox.className = 'form-check-input ares-checkbox';
                        // Usar el índice real en data, no en el índice del bucle
                        checkbox.value = i;
                        
                        // Sincronizar el estado del checkbox con la selección global
                        if (selectedAresData.has(checkbox.value)) {
                            checkbox.checked = true;
                        }
                        
                        checkbox.addEventListener('change', function() {
                            if (this.checked) {
                                selectedAresData.add(this.value);
                            } else {
                                selectedAresData.delete(this.value);
                            }
                            updateAresSelectionCount();
                        });
                        tdCheckbox.appendChild(checkbox);
                        tr.appendChild(tdCheckbox);
                    }
                    
                    columns.forEach(col => {
                        const td = document.createElement('td');
                        // Always show a cell for every column, even if the value is blank
                        let value = row[col];
                        if (value === undefined || value === null) value = '';
                        
                        // Manejo especial para la columna Json Movimientos
                        if (col === 'Json Movimientos' && value) {
                            const button = document.createElement('button');
                            button.className = 'btn btn-sm btn-outline-primary';
                            button.textContent = 'Ver JSON';
                            button.onclick = function() {
                                showJsonModal(value);
                            };
                            td.appendChild(button);
                        } else {
                            td.textContent = value;
                        }
                        tr.appendChild(td);
                    });
                    body.appendChild(tr);
                }

                // Configurar checkbox "Seleccionar todo" para ARES
                if (selectedType === 'ares') {
                    const selectAllCheckbox = document.getElementById('selectAllCheckbox');
                    if (selectAllCheckbox) {
                        selectAllCheckbox.addEventListener('change', function() {
                            if (this.checked) {
                                // Seleccionar TODOS los registros filtrados, no solo los de la página actual
                                selectedAresData.clear();
                                for (let i = 0; i < filteredGridData.length; i++) {
                                    selectedAresData.add(i.toString());
                                }
                                // Marcar todos los checkboxes visibles
                                const checkboxes = document.querySelectorAll('.ares-checkbox');
                                checkboxes.forEach(checkbox => {
                                    checkbox.checked = true;
                                });
                            } else {
                                // Deseleccionar todos
                                selectedAresData.clear();
                                const checkboxes = document.querySelectorAll('.ares-checkbox');
                                checkboxes.forEach(checkbox => {
                                    checkbox.checked = false;
                                });
                            }
                            updateAresSelectionCount();
                        });
                    }
                    
                    // Actualizar el estado del checkbox principal después de renderizar
                    updateSelectAllCheckboxState();
                    // Sincronizar los checkboxes visibles con el estado global
                    setTimeout(() => syncVisibleCheckboxes(), 100);
                }
            }

            // --- GLOBALS FOR SELECTION ---
            let selectedOption = '';
            let selectedType = '';

            // Submodule selection: only highlight and store selection
            document.querySelectorAll('.submodule-link').forEach(link => {
                link.addEventListener('click', function () {
                    document.querySelectorAll('.submodule-link').forEach(l => l.classList.remove('active'));
                    this.classList.add('active');
                    selectedOption = this.getAttribute('data-option');
                    selectedType = this.getAttribute('data-type');
                    
                    // Limpiar la sección de datos cuando se cambie de módulo
                    clearDataSection();
                    
                    // Mostrar/ocultar controles de selección ARES
                    const aresControls = document.getElementById('aresSelectionControls');
                    if (selectedType === 'ares') {
                        aresControls.style.display = 'block';
                    } else {
                        aresControls.style.display = 'none';
                    }
                    
                    // Mostrar/ocultar botón de Ver Información Integrada
                    const integrarViewBtn = document.getElementById('integrarViewBtn');
                    if (selectedType === 'integrar') {
                        integrarViewBtn.style.display = 'inline-block';
                    } else {
                        integrarViewBtn.style.display = 'none';
                    }
                    
                    // Inhabilitar botón de ejecutar para opciones que solo permiten visualización
                    const executeBtn = document.getElementById('executeBtn');
                    if (selectedType === 'integrar' && selectedOption === '08') {
                        // Opción #8: BCN: Balance operativo - solo visualización
                        executeBtn.disabled = true;
                        executeBtn.title = 'Esta opción solo permite visualización';
                        executeBtn.classList.add('btn-secondary');
                        executeBtn.classList.remove('btn-primary');
                    } else {
                        // Habilitar botón de ejecutar para otras opciones
                        executeBtn.disabled = false;
                        executeBtn.title = 'Ejecutar';
                        executeBtn.classList.remove('btn-secondary');
                        executeBtn.classList.add('btn-primary');
                    }
                    
                    // Asegurar que la paginación esté oculta después de limpiar
                    setTimeout(() => {
                        const paginationContainer = document.getElementById('paginationContainer');
                        if (paginationContainer) {
                            paginationContainer.style.display = 'none';
                        }
                    }, 100);
                });
            });

            // Función para limpiar la sección de datos
            function clearDataSection() {
                const header = document.getElementById('mainGridHeader');
                const body = document.getElementById('mainGridBody');
                const paginationContainer = document.getElementById('paginationContainer');
                const paginationInfo = document.getElementById('paginationInfo');
                const paginationControls = document.getElementById('paginationControls');
                
                // Limpiar header y body de la tabla
                if (header) header.innerHTML = '';
                if (body) body.innerHTML = '';
                
                // Ocultar paginación y limpiar su contenido
                if (paginationContainer) {
                    paginationContainer.style.display = 'none';
                }
                if (paginationInfo) {
                    paginationInfo.innerHTML = '';
                }
                if (paginationControls) {
                    paginationControls.innerHTML = '';
                }
                
                // Limpiar variables globales
                lastGridData = [];
                lastGridColumns = [];
                lastGridTitle = '';
                originalGridData = [];
                filteredGridData = [];
                currentSearchTerm = '';
                columnFilters = {};
                currentPage = 1;
                pageSize = 10; // Resetear el tamaño de página por defecto
                selectedAresData.clear();
                
                // Limpiar búsqueda
                const searchInput = document.getElementById('searchTable');
                if (searchInput) {
                    searchInput.value = '';
                }
                
                // Limpiar filtros de columna
                document.querySelectorAll('.column-filter').forEach(input => {
                    input.value = '';
                });
                
                // Resetear el selector de tamaño de página
                const pageSizeSelect = document.getElementById('pageSizeSelect');
                if (pageSizeSelect) {
                    pageSizeSelect.value = '10';
                }
                
                // Mostrar mensaje de selección
                if (body) {
                    body.innerHTML = `
                        <tr>
                            <td class="text-center py-5">
                                <div class="no-data-message info">
                                    <i class="bi bi-arrow-left"></i>
                                    <h5>Seleccione un submódulo para consultar</h5>
                                    <p>Elija una opción del panel lateral para comenzar</p>
                                    <small>
                                        <i class="bi bi-info-circle me-1"></i>
                                        Utilice el menú de la izquierda para navegar entre las diferentes opciones disponibles.
                                    </small>
                                </div>
                            </td>
                        </tr>
                    `;
                }
                
                // Crear header básico
                if (header) {
                    const headerRow = document.createElement('tr');
                    const thTitle = document.createElement('th');
                    thTitle.colSpan = 1;
                    thTitle.className = 'main-title';
                    thTitle.id = 'mainGridTitle';
                    thTitle.textContent = 'SELECCIONA UN MÓDULO PARA VISUALIZAR DATOS';
                    headerRow.appendChild(thTitle);
                    header.appendChild(headerRow);
                }
            }

            // Variables para manejo de selección ARES
            let selectedAresData = new Set();

            // Función para seleccionar todos los datos ARES
            function selectAllAresData() {
                selectedAresData.clear();
                // Seleccionar TODOS los registros filtrados, no solo los de la página actual
                for (let i = 0; i < filteredGridData.length; i++) {
                    selectedAresData.add(i.toString());
                }
                // Marcar todos los checkboxes visibles
                document.querySelectorAll('.ares-checkbox').forEach(checkbox => {
                    checkbox.checked = true;
                });
                // Marcar también el checkbox principal
                const selectAllCheckbox = document.getElementById('selectAllCheckbox');
                if (selectAllCheckbox) {
                    selectAllCheckbox.checked = true;
                }
                updateAresSelectionCount();
            }

            // Función para deseleccionar todos los datos ARES
            function deselectAllAresData() {
                selectedAresData.clear();
                // Deseleccionar todos los checkboxes visibles
                document.querySelectorAll('.ares-checkbox').forEach(checkbox => {
                    checkbox.checked = false;
                });
                // Deseleccionar también el checkbox principal
                const selectAllCheckbox = document.getElementById('selectAllCheckbox');
                if (selectAllCheckbox) {
                    selectAllCheckbox.checked = false;
                }
                updateAresSelectionCount();
            }

            // Función para actualizar contador de selección
            function updateAresSelectionCount() {
                const sendButton = document.querySelector('button[onclick="sendSelectedToAres()"]');
                if (sendButton) {
                    const count = selectedAresData.size;
                    sendButton.innerHTML = `<i class="bi bi-send"></i> Enviar a ARES (${count})`;
                }
                
                // Actualizar el estado del checkbox principal
                updateSelectAllCheckboxState();
            }
            
            // Función para actualizar el estado del checkbox principal
            function updateSelectAllCheckboxState() {
                const selectAllCheckbox = document.getElementById('selectAllCheckbox');
                if (selectAllCheckbox && filteredGridData && filteredGridData.length > 0) {
                    const totalRecords = filteredGridData.length;
                    const selectedCount = selectedAresData.size;
                    
                    if (selectedCount === 0) {
                        selectAllCheckbox.checked = false;
                        selectAllCheckbox.indeterminate = false;
                    } else if (selectedCount === totalRecords) {
                        selectAllCheckbox.checked = true;
                        selectAllCheckbox.indeterminate = false;
                    } else {
                        selectAllCheckbox.checked = false;
                        selectAllCheckbox.indeterminate = true;
                    }
                    
                    // Debug: mostrar en consola el estado actual
                    console.log(`Checkbox principal: total=${totalRecords}, seleccionados=${selectedCount}, checked=${selectAllCheckbox.checked}, indeterminate=${selectAllCheckbox.indeterminate}`);
                }
            }
            
            // Función para sincronizar todos los checkboxes visibles con el estado global
            function syncVisibleCheckboxes() {
                if (selectedType === 'ares') {
                    const checkboxes = document.querySelectorAll('.ares-checkbox');
                    checkboxes.forEach(checkbox => {
                        const isSelected = selectedAresData.has(checkbox.value);
                        if (checkbox.checked !== isSelected) {
                            checkbox.checked = isSelected;
                        }
                    });
                    
                    // Debug: mostrar en consola el estado de sincronización
                    console.log(`Sincronizando checkboxes visibles: ${checkboxes.length} checkboxes, ${selectedAresData.size} seleccionados globalmente`);
                }
            }

            // Función para enviar datos seleccionados a ARES
            async function sendSelectedToAres() {
                if (selectedAresData.size === 0) {
                    alert('Seleccione al menos un registro para enviar a ARES.');
                    return;
                }

                if (!selectedOption || selectedType !== 'ares') {
                    alert('Debe seleccionar una opción ARES válida.');
                    return;
                }

                const confirmed = confirm(`¿Está seguro de enviar ${selectedAresData.size} registros seleccionados a ARES?`);
                if (!confirmed) return;

                try {
                    // Obtener los datos seleccionados usando los índices reales de filteredGridData
                    const selectedRows = [];
                    selectedAresData.forEach(indexStr => {
                        const rowIndex = parseInt(indexStr);
                        if (filteredGridData[rowIndex]) {
                            selectedRows.push(filteredGridData[rowIndex]);
                        }
                    });

                    // Mapear datos según el tipo de ARES
                    let mappedData = [];
                    switch (selectedOption) {
                        case "01": // Inventario logístico
                            mappedData = selectedRows.map(row => ({
                                dtContabilizacion: row['Fecha Contabilización'] || row['Fecha Contabilizacion'] || '',
                                idRecurso: row['ID Recurso'] || '',
                                idProducto: row['ID Producto'] || '',
                                idCELO: row['ID CELO'] || '',
                                idALMACEN: row['ID Almacén'] || row['ID Almacen'] || '',
                                idMaterial: row['ID Material'] || '',
                                vlContable: row['Valor Contable'] || '',
                                idUMContable: row['UM Contable'] || '',
                                idUsrAuditoria: row['Usuario Auditoría'] || row['Usuario Auditoria'] || 'AdminBCN',
                                dtUsrAuditoria: row['Fecha Auditoría'] || row['Fecha Auditoria'] || new Date().toISOString().slice(0, 19).replace('T', ' ')
                            }));
                            break;
                        case "02": // Movimiento logístico
                            // Mapear para movimientos logísticos (ajustar según estructura esperada)
                            case "02": // Movimiento logístico
                            mappedData = selectedRows.map((row, index) => ({
                                IDMessage: String(row["ID Mensaje"] || ""),
                                dtContabilizacion: String(row["Fecha Contabilización"] || row["Fecha Contabilizacion"] || ""),
                                idMovimiento: String(row["ID Movimiento"] || ""),
                                dtMovimientoIni: String(row["Fecha Inicio"] || ""),
                                dtMovimientoFin: String(row["Fecha Fin"] || ""),
                                tpMovimiento: String(row["Tipo Movimiento"] || ""),
                                clsMovimiento: String(row["Clase Movimiento"] == '9G5' ? '101' : row["Clase Movimiento"] || ""),
                                TransactionCodeSAP: String(row["Código Transacción SAP"] || row["Codigo Transacción SAP"] || row["Codigo Transaccion SAP"] || ""),
                                StockTypeSAP: String(row["Tipo Stock SAP"] || ""),
                                NumPedido: String(row["Número Pedido"] || row["Numero Pedido"] || ""),
                                PosPedido: String(row["Posición Pedido"] || row["Posicion Pedido"] || ""),
                                idRecOrigen: String(row["Recurso Origen"] || ""),
                                idProdOrigen: String(row["Producto Origen"] || ""),
                                idRecDestino: String(row["Recurso Destino"] || ""),
                                idProdDestino: String(row["Producto Destino"] || ""),
                                idSRCCELO: String(row["CeLo Origen"] || ""),
                                idSRCALMACEN: String(row["Almacén Origen"] || row["Almacen Origen"] || ""),
                                idSRCMaterial: String(row["Material Origen"] || ""),
                                idDSTCCELO: String(row["CeLo Destino"] || ""),
                                idDSTALMACEN: String(row["Almacén Destino"] || row["Almacen Destino"] || ""),
                                idDSTMaterial: String(row["Material Destino"] || ""),
                                vlContable: String(row["Valor Contable"] || ""),
                                idUMContable: String(row["UM Contable"] || ""),
                                idCentroCosto: String(row["CeCo"] || ""),
                                txEstadoEnvio: String(row["Estado de Envío"] || row["Estado de Envio"] || ""),
                                vlAtrCalidad: String(row["Valor Atributo Calidad"] || ""),
                                idUMAtrCalidad: String(row["UM Atributo Calidad"] || ""),
                                vlCantidaadQCI: String(row["Valor QCI"] || ""),
                                idUMCantidadQCI: String(row["ID UM QCI"] || ""),
                                txCantidadQCI: String(row["Cantidad QCI"] || ""),
                                IdPropiedad: String(row["IdPropiedad"] || ""),
                                jsMovimiento: String(row["Json Movimientos"] || ""),
                                idUsrAuditoria: String(row["Usuario Auditoria"] || row["Usuario Auditoría"] || "AdminBCN"),
                                dtUsrAuditoria: String(row["Fecha Auditoría"] || row["Fecha Auditoria"] || new Date().toISOString().slice(0, 19).replace("T", " "))
                            }));
                            break;
                        case "03": // Movimiento de costos
                            mappedData = selectedRows.map(row => ({
                                idMessage: row['ID Mensaje'] || '',
                                tpObjCostos: row['Tipo Objeto Costos'] || '',
                                txMovimiento: row['Texto Movimiento'] || '',
                                dtContabilizacion: row['Fecha Contabilización'] || row['Fecha Contabilizacion'] || '',
                                idObjCosto: row['ID Objeto Costo'] || '',
                                idValEstadistico: row['ID Valor Estadístico'] || row['ID Valor Estadistico'] || '',
                                nmProducto: row['Nombre Producto'] || '',
                                idUM: row['UM'] || '',
