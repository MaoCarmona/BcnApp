            }

            // Función para mostrar notificación de error
            function showExportErrorNotification(message) {
                const notificationContainer = document.getElementById('stickyNotificationContainer');
                if (!notificationContainer) return;

                const notification = document.createElement('div');
                notification.className = 'no-data-message warning';
                notification.style.cssText = `
