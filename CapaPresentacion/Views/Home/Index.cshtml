                            break;
                        case "03": // Movimiento de costos
                            requestData.costData = String(JSON.stringify(mappedData));
                            break;
                    }

                    // Enviar a ARES
                    const requestBody = JSON.stringify({
                            option: selectedOption,
                            ...requestData
                        });

                    console.log('Request body:', requestBody);
                    
                    const response = await fetch('/Integration/ExecuteAresWbService', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: requestBody
                    });

                    const result = await response.json();

                    console.log('Response:', JSON.stringify(result));
                    
                    if (result.Success) {
                        // Verificar el StatusCode de cada elemento en result.Data
                        if (result.Data && Array.isArray(result.Data)) {
                            const successCount = result.Data.filter(item => item.StatusCode === 200).length;
                            const failedCount = result.Data.filter(item => item.StatusCode === 500).length;
                            
                            if (failedCount === 0) {
                                alert(`Envío exitoso: ${successCount} registros enviados correctamente a ARES`);
                                // Deseleccionar después del envío exitoso
                                deselectAllAresData();
                            } else if (successCount === 0) {
                                alert(`Error en el envío: ${failedCount} registros fallaron. Revisar logs para más detalles.`);
                            } else {
                                alert(`Envío parcial: ${successCount} registros exitosos, ${failedCount} registros fallaron. Revisar logs para más detalles.`);
                            }
                            
                            // Mostrar detalles en consola para debugging
                            console.log(`Resultados: ${successCount} exitosos, ${failedCount} fallidos`);
                            result.Data.forEach((item, index) => {
                                if (item.StatusCode === 500) {
                                    console.error(`Error en registro ${index + 1}:`, item.Message);
                                }
                            });
                        } else {
                            alert(`Envío exitoso: ${result.message || 'Datos enviados correctamente a ARES'}`);
                            deselectAllAresData();
                        }
                    } else {
                        alert(`Error en el envío: ${result.message || 'Error desconocido'}`);
