            // Función para ejecutar la consulta
            async function executeQuery(fechaIni, fechaFin, useInitialDate, viewIntegrar) {
                // Format dates for display based on user request AAAA-MM-DD HH:MM:SS
                const displayFechaIni = fechaIni;
                const displayFechaFin = fechaFin;

                if (requiresDateSelection(selectedType, selectedOption)) {
                    const selectedDateStr = useInitialDate ? displayFechaIni : displayFechaFin;
                    lastQueryDateInfo = `Fecha de Consulta: ${selectedDateStr}`;
                } else {
                    const fromDateStr = fechaIni.split(' ')[0];
                    const toDateStr = fechaFin.split(' ')[0];
                    if (fromDateStr === toDateStr) {
                        lastQueryDateInfo = `Fecha de Consulta: ${fromDateStr}`;
                    } else {
                        lastQueryDateInfo = `Rango: ${displayFechaIni} al ${displayFechaFin}`;
                    }
                }

                // Show cancel button and hide execute button
                document.getElementById('executeBtn').style.display = 'none';
                if (selectedType === 'integrar') {
                    document.getElementById('integrarViewBtn').style.display = 'none';
                }
                document.getElementById('cancelBtn').style.display = 'inline-block';
                isExecuting = true;

                // Show progress indicator
                document.getElementById('progressIndicator').style.display = 'block';
                document.getElementById('progressMessage').textContent = 'Ejecutando consulta...';
                
                const body = document.getElementById('mainGridBody');
                const header = document.getElementById('mainGridHeader');
                
                body.innerHTML = '<tr><td colspan="100%" class="text-center text-info"><i class="bi bi-hourglass-split"></i> Cargando...</td></tr>';
                header.innerHTML = '';

                try {
                    // Create abort controller for this request
                    currentAbortController = new AbortController();
                    const signal = currentAbortController.signal;

                    const request = {
                        option: selectedOption,
                        fechaIni: fechaIni,
                        fechaFin: fechaFin,
                        type: selectedType,
                        useInitialDate: useInitialDate,
                        viewDataIntegrar: viewIntegrar
                    };
                    console.log(JSON.stringify(request));
                    
                    const response = await fetch('/Integration/DynamicQuery', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(request),
                        signal: signal
                    });

                    if (signal.aborted) {
                        console.log('Request was cancelled');
                        return;
                    }

                    const result = await response.json();
                    console.log(result.message);
                    
                    if (result.success) {
                        // Reiniciar el estado de la paginación y los filtros con los nuevos datos
                        currentPage = 1;
                        pageSize = parseInt(document.getElementById('pageSizeSelect').value) || 10;
                        clearAllFilters(false); // Limpiar filtros sin volver a renderizar

                        // Check if we have data to display in the grid
                        if (result.data && result.data.length > 0 && result.columns && result.columns.length > 0) {
                            renderGrid(result.columns, result.data, document.querySelector('.submodule-link.active')?.textContent.trim() || '');
                        } else {
                            // Mostrar mensaje elegante cuando no hay datos
                            renderNoDataMessage(result.message || 'No hay datos para mostrar');
                        }
                    } else {
                        renderGrid(["Error"], [{"Error": result.message || 'Error en la operación'}], document.querySelector('.submodule-link.active')?.textContent.trim() || '');
                    }
                } catch (err) {
                    if (err.name === 'AbortError') {
                        console.log('Request was cancelled by user');
                        renderGrid(["Cancelado"], [{"Cancelado": "Operación cancelada por el usuario"}], document.querySelector('.submodule-link.active')?.textContent.trim() || '');
                    } else {
                        console.error('Error en la consulta:', err);
                        renderGrid(["Error"], [{"Error": `Error de conexión: ${err.message}`}], document.querySelector('.submodule-link.active')?.textContent.trim() || '');
                    }
                } finally {
                    // Reset UI state
                    document.getElementById('executeBtn').style.display = 'inline-block';
                    if (selectedType === 'integrar') {
                        document.getElementById('integrarViewBtn').style.display = 'inline-block';
                    }
                    document.getElementById('cancelBtn').style.display = 'none';
                    document.getElementById('progressIndicator').style.display = 'none';
                    isExecuting = false;
                    currentAbortController = null;
                }
            }

